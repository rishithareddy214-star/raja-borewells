generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusinessProfile {
  id            String   @id @default(cuid())
  businessName  String   @db.VarChar(200)
  ownerName     String   @db.VarChar(200)
  phone         String   @db.VarChar(50)
  whatsapp      String   @db.VarChar(50)
  email         String   @db.VarChar(200)
  address       String   @db.VarChar(300)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  businessHours String  @db.VarChar(200)
  experience    String   @db.VarChar(100)
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Service {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(200)
  description String        @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  rates       ServiceRate[]
  enquiries   Enquiry[]
}

model ServiceRate {
  id           String   @id @default(cuid())
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceLabel String   @db.VarChar(200)
  unit         String   @db.VarChar(50)
  startingRate String   @db.VarChar(100)
  details      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  title       String        @db.VarChar(200)
  location    String        @db.VarChar(200)
  type        String        @db.VarChar(100)
  diameter    String        @db.VarChar(100)
  depth       String        @db.VarChar(100)
  date        String        @db.VarChar(50)
  status      String        @db.VarChar(50)
  description String        @db.Text
  image       String        @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  images      ProjectImage[]
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String   @db.Text
  createdAt DateTime @default(now())
}

model ServiceArea {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(200)
  pincode   String?  @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([pincode])
}

model Enquiry {
  id            String   @id @default(cuid())
  leadId        String   @unique
  customerName  String   @db.VarChar(200)
  phone         String   @db.VarChar(50)
  whatsapp      String?  @db.VarChar(50)
  area          String?  @db.VarChar(200)
  city          String?  @db.VarChar(100)
  landType      String?  @db.VarChar(100)
  village       String?  @db.VarChar(200)
  pincode       String?  @db.VarChar(20)
  googleMaps    String?  @db.Text
  latitude      Float?
  longitude     Float?
  purpose       String?  @db.VarChar(100)
  landSize      String?  @db.VarChar(100)
  serviceLabel  String?  @db.VarChar(200)
  contactType   String?  @db.VarChar(30)
  sourcePage    String?  @db.VarChar(300)
  leadSource    String?  @db.VarChar(50)
  deviceType    String?  @db.VarChar(30)
  possibleDuplicate Boolean @default(false)
  followUpAt    DateTime?
  followUpDone  Boolean  @default(false)
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id])
  borewellType  String?  @db.VarChar(100)
  approxDepth   String?  @db.VarChar(100)
  boreDiameter  String?  @db.VarChar(100)
  preferredDate String?  @db.VarChar(50)
  message       String?  @db.Text
  status        String   @db.VarChar(50) @default("NEW")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  notes         CustomerNote[]
  quotations    Quotation[]

  @@index([phone])
  @@index([status])
  @@index([area])
  @@index([serviceLabel])
  @@index([leadSource])
  @@index([createdAt])
  @@index([followUpAt, followUpDone])
}

model SiteVisit {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(200)
  phone         String   @db.VarChar(50)
  location      String   @db.VarChar(200)
  googleMaps    String?  @db.Text
  landType      String?  @db.VarChar(100)
  preferredDate String?  @db.VarChar(50)
  preferredTime String?  @db.VarChar(50)
  message       String?  @db.Text
  status        String   @db.VarChar(50) @default("New")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([status])
}

model Review {
  id          String   @id @default(cuid())
  customerName String  @db.VarChar(200)
  area        String   @db.VarChar(200)
  rating      Int
  review      String   @db.Text
  date        String   @db.VarChar(50)
  approved    Boolean  @default(false)
  permissionToPublish Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(300)
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(200)
  email     String?  @db.VarChar(200)
  phone     String   @db.VarChar(50)
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(200) @unique
  password  String   @db.Text
  role      String   @default("ADMIN") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactEvent {
  id          String   @id
  contactType String   @db.VarChar(30)
  sourcePage  String   @db.VarChar(300)
  serviceId   String?
  area        String?  @db.VarChar(200)
  deviceType  String   @db.VarChar(30)
  createdAt   DateTime @default(now())

  @@index([contactType, createdAt])
  @@index([sourcePage])
}

model CallbackRequest {
  id           String   @id
  name         String   @db.VarChar(200)
  phone        String   @db.VarChar(50)
  preferredTime String  @db.VarChar(30)
  message      String?  @db.Text
  status       String   @default("New") @db.VarChar(30)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model CustomerNote {
  id        String   @id
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  note      String   @db.Text
  createdAt DateTime @default(now())

  @@index([enquiryId, createdAt])
}

model Quotation {
  id                String   @id
  quotationId       String   @unique
  secureToken       String   @unique
  enquiryId         String
  enquiry           Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  description       String   @db.Text
  quantity          Decimal  @db.Decimal(12, 2)
  unit              String   @db.VarChar(50)
  rate              Decimal  @db.Decimal(12, 2)
  additionalCharges Decimal  @default(0) @db.Decimal(12, 2)
  discount          Decimal  @default(0) @db.Decimal(12, 2)
  tax               Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal  @db.Decimal(12, 2)
  validity          String?  @db.VarChar(100)
  terms             String?  @db.Text
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([enquiryId, createdAt])
}

model AdminActivityLog {
  id         String   @id
  adminEmail String   @db.VarChar(200)
  action     String   @db.VarChar(100)
  recordType String   @db.VarChar(100)
  recordId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @db.VarChar(200) @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
